# Server-side application configuration
DATABASE_URL=
NODE_ENV=development
# Campaign dispatch retries transient Neon transport failures before the
# durable BullMQ retry policy takes over. SQL errors are never retried here.
CAMPAIGN_DATABASE_RETRY_ATTEMPTS=3
CAMPAIGN_DATABASE_RETRY_DELAY_MS=250
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# Optional dedicated HMAC secret for campaign open/click/unsubscribe links.
CAMPAIGN_TRACKING_SECRET=

# One public origin used for OAuth callbacks, payments, event links, branded
# files, campaign tracking, and the Vite development host allow-list. Use
# http://localhost:8080 locally. Production campaign sends require a stable
# HTTPS deployment origin; do not leave a temporary tunnel URL here at release.
PUBLIC_APP_URL=http://localhost:8080
# Legacy callback-origin aliases. Leave blank to use PUBLIC_APP_URL.
APP_BASE_URL=
AUTH_OAUTH_BASE_URL=
INTEGRATION_OAUTH_BASE_URL=
PAYMENT_PROVIDER_BASE_URL=
# Development only: explicitly allow a local campaign smoke send.
ALLOW_DEV_CAMPAIGN_SEND=false
CAMPAIGN_BATCH_STALE_MINUTES=15
# Optional alert destination for analytics dead letters. Keep server-only.
CAMPAIGN_ANALYTICS_ALERT_WEBHOOK_URL=
# How long a branded file link stays valid. 60-3600 seconds, default 900.
BRANDED_FILE_URL_TTL_SECONDS=900

# Upstash Redis (server-only; never prefix these with VITE_). Backs the read
# cache and rate limiting. Both are fail-open: leave these blank and every
# cached read goes to the database and rate limiting falls back as before.
# Create the database in the same region the app is deployed to, otherwise a
# cache read can cost more than the query it replaces.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# BullMQ requires Upstash's TLS/TCP endpoint; REST credentials above remain
# for the serverless cache helpers.
UPSTASH_REDIS_HOST=
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_USERNAME=default
UPSTASH_REDIS_PASSWORD=
# Preferred BullMQ connection format. Use a read/write Redis TCP credential;
# REST credentials or a read-only Redis user cannot run workers.
REDIS_URL=
QUEUE_PREFIX=maxform
QUEUE_REQUIRED=true
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=30000
QUEUE_REDIS_CONNECT_TIMEOUT_MS=8000
EMAIL_WORKER_CONCURRENCY=5
TRANSACTIONAL_EMAIL_CONCURRENCY=10
EMAIL_WEBHOOK_CONCURRENCY=10
EMAIL_DEAD_LETTER_CONCURRENCY=2
CAMPAIGN_ORCHESTRATOR_CONCURRENCY=2
CAMPAIGN_DELIVERY_CONCURRENCY=5
CAMPAIGN_METRICS_CONCURRENCY=1

# ToSend provider API credentials are entered in Email settings and encrypted
# per workspace. The shared webhook secret is deployment security, not a
# provider account key, and is only needed when a ToSend webhook is configured.
TOSEND_WEBHOOK_SECRET=
TOSEND_ALLOW_UNSIGNED_WEBHOOKS=false

# Local email adapter controls. Leave EMAIL_PROVIDER blank to use the
# configured workspace provider; set it to mock only for local smoke tests.
EMAIL_PROVIDER=
MOCK_EMAIL_OUTCOME=success

# Campaign pacing and safety. Provider account limits are read live when the
# adapter supports it, then constrained by these application-level controls.
CAMPAIGN_DEFAULT_BATCH_SIZE=100
# Campaigns at or below this recipient count use the synchronous direct path,
# subject to the workspace/provider safety ceiling. Larger sends use BullMQ.
CAMPAIGN_BULK_THRESHOLD=100
CAMPAIGN_BATCH_DELAY_MS=1000
CAMPAIGN_TEMPORARY_FAILURE_SLOW_RATE=0.1
EMAIL_PROVIDER_RATE_SAFETY_FACTOR=0.8
EMAIL_HEALTH_SECRET=
# Bump to invalidate every cached value at once, e.g. after a schema change.
CACHE_VERSION=1

# Cloudflare R2 object storage (server-only; never prefix these with VITE_).
# Keep the primary bucket private. Use a separate public bucket connected to a
# production custom domain for public event/form/email media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=https://assets.example.com
# Optional override; defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_SIGNED_URL_TTL_SECONDS=300
R2_UPLOAD_URL_TTL_SECONDS=300
R2_MULTIPART_THRESHOLD_BYTES=26214400
R2_MULTIPART_PART_BYTES=10485760
R2_MAX_ATTEMPTS=3

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# Register this redirect URI in Google Cloud:
# ${PUBLIC_APP_URL}/api/auth?action=google-callback
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Appointments — scheduling provider connections
#
# Every provider below shares ONE redirect URI. Register this exact string with
# each provider (swap the host for your production origin):
#
#   ${PUBLIC_APP_URL}/api/appointments/integrations?action=callback
#
# A provider with an empty client id shows as "Not available" in the
# Integrations tab instead of offering a Connect button that cannot work.

# Google Calendar and Google Meet both use GOOGLE_CLIENT_ID/SECRET above.
# Enable the Google Calendar API on the project, and add these scopes:
#   .../auth/calendar.events  .../auth/calendar.readonly  openid  email

# Outlook Calendar and Microsoft Teams share one app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Zoom → Marketplace → Build App → General App (User-managed).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Older Zoom apps need the classic pair: ZOOM_SCOPES="meeting:write user:read"
ZOOM_SCOPES=

# Calendly → Integrations → API & webhooks → OAuth applications.
# Without these, the Integrations tab offers a personal access token instead.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Cal.com has no self-serve OAuth for individual accounts, so each user pastes
# their own API key in the UI. Nothing to configure here.

# Override a provider's scopes if it renames them (space or comma separated).
GOOGLE_CALENDAR_SCOPES=
GOOGLE_MEET_SCOPES=
MICROSOFT_OUTLOOK_SCOPES=
MICROSOFT_TEAMS_SCOPES=

# Server-side payment provider connections
PAYMENT_ENCRYPTION_KEY=
PAYMENT_MODE=test
# Keep this false unless the app is behind a proxy that overwrites forwarded
# headers. Set true only for a trusted edge/CDN; it enables real-client IP
# limits instead of the proxy socket address.
TRUST_PROXY_HEADERS=false
# Server-to-provider request deadline in milliseconds (3,000–30,000).
PAYMENT_PROVIDER_TIMEOUT_MS=12000
PROVIDER_TIMEOUT_MS=12000
PAYPAL_MODE=test

# Server-side workspace email delivery. This key is used only to encrypt
# provider credentials at rest; never prefix it with VITE_.
EMAIL_ENCRYPTION_KEY=
EMAIL_PROVIDER_TIMEOUT_MS=12000
# Managed Sending stores a workspace-specific prefix and combines it with
# this MaxForm-controlled domain. The old full-address variables are retained
# only for compatibility and no longer override the workspace sender.
MAXFORM_MANAGED_SENDING_DOMAIN=send.moodtravelabroad.com
# Server-only Resend key for MaxForm Managed Sending. Never prefix with VITE_.
MAXFORM_MANAGED_RESEND_API_KEY=
MAXFORM_MANAGED_FROM_EMAIL=
MAXFORM_SHARED_FROM_EMAIL=
# Dedicated non-production workspace used only by state-restoring email smoke tests.
# Smoke scripts refuse to select an arbitrary user when this is empty.
MAXFORM_EMAIL_SMOKE_USER_ID=
# Explicit real inbox for the delivery smoke test.
RESEND_SMOKE_RECIPIENT=

STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Scheduler credential for the campaign and queued-email dispatchers. Must
# match the value configured for the Vercel Cron job. Minimum 16 characters.
CRON_SECRET=""
# Optional separate secret for the queued-email worker. If blank, CRON_SECRET
# is used so the two Vercel Cron routes share one scheduler credential.
EMAIL_WORKER_SECRET=""
# Optional separate secret for the campaign analytics worker. If blank, the
# Vercel CRON_SECRET is accepted. Keep this at least 16 characters long.
CAMPAIGN_ANALYTICS_WORKER_SECRET=""

# ---------------------------------------------------------------------------
# Connected stores (Shopify, WooCommerce, BigCommerce and Wix)
#
# Store credentials are entered per workspace and encrypted at rest. These
# values only control the server-side encryption and reconciliation worker;
# never prefix them with VITE_. Generate CMS_ENCRYPTION_KEY independently in
# production. INTEGRATION_ENCRYPTION_KEY is a compatibility fallback.
CMS_ENCRYPTION_KEY=""
CMS_RECONCILIATION_BATCH_SIZE=5
CMS_RECONCILIATION_INTERVAL_MINUTES=1
CMS_RECONCILIATION_FALLBACK_INTERVAL_MINUTES=1
CMS_SYNC_LEASE_MINUTES=10
CMS_SYNC_TIMEOUT_MS=15000
CMS_WEBHOOK_MAX_BODY_BYTES=2000000
SHOPIFY_ADMIN_API_VERSION=2026-07
# Shopify webhook HMAC secret from the Shopify app's Client credentials.
# This is server-only and is separate from each workspace's encrypted token.
SHOPIFY_APP_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI assistant (server-only; never prefix these with VITE_).
#
# One engine powers the floating assistant, the AI Workspace tab and every
# in-module "Ask AI" entry point, so changing the model here changes it
# everywhere at once. Leave the key blank and the assistant reports itself as
# unavailable rather than failing mid-conversation; nothing else breaks.
# anthropic | openai | gemini | openai-compatible
#
# `openai-compatible` is how any other vendor runs without new code: Groq,
# OpenRouter, Together, Mistral, DeepSeek, Fireworks, and local runtimes like
# Ollama, vLLM and LM Studio all speak the OpenAI Chat Completions shape, so
# they differ only by base URL, key and model name.
#
# These are deployment defaults and diagnostics. Authenticated workspaces must
# connect their own provider from MaxAI Settings; their encrypted workspace row
# wins for live requests. The integration key is retained only as a fallback
# encryption secret for existing deployments.
# Leave blank to auto-detect the first configured server-side key. Set this
# explicitly when more than one provider is configured or a specific vendor
# must always be used.
# Gemini is the default workspace provider. Set another supported provider only
# when that provider's server-side key is configured below.
AI_PROVIDER=gemini
AI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Only needed when AI_PROVIDER=gemini. GOOGLE_API_KEY works as an alias.
# The default model is gemini-2.5-flash: gemini-2.5-pro has a free-tier quota
# of zero, so a key without billing enabled 429s on its very first message.
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Only needed when AI_PROVIDER=openai-compatible. Examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#   Ollama      http://localhost:11434/v1
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
# Optional diagnostic target for the workspace-aware AI smoke/verify scripts.
AI_WORKSPACE_ID=
# Optional dedicated encryption key for API keys saved from MaxAI settings.
# Generate a random value of at least 24 characters in production. If blank,
# INTEGRATION_ENCRYPTION_KEY is used when it is available.
AI_ENCRYPTION_KEY=
# How hard the model works per turn: low, medium, high, xhigh, max. Low keeps
# interactive chat responsive; raise it when depth matters more than speed.
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1024
AI_PROVIDER_TIMEOUT_MS=45000
# Hours until first human reply, shown honestly on an escalation rather than
# as a vague "someone will get back to you". 1-168, default 24.
AI_SUPPORT_RESPONSE_HOURS=24

# ---------------------------------------------------------------------------
# Shared safety and background-worker placeholders
ALLOW_INSECURE_EVENT_LINKS=false
ALLOW_INSECURE_WEBHOOKS=false
EVENT_TICKET_DOWNLOAD_SECRET=""
EVENT_TICKET_SECRET=""
WORKFLOW_WORKER_CONCURRENCY=5

# Vercel supplies these automatically in hosted environments. They are listed
# so local tooling and deployment validation have an explicit contract.
VERCEL=
VERCEL_ENV=
VERCEL_URL=

# Legacy storage test alias; keep empty unless a local test explicitly needs it.
VITE_R2_SECRET_ACCESS_KEY=

# Optional local verification/load-test inputs. These are not required by the
# running dashboard and should stay blank unless a named script is run.
DEV_PUBLIC_APP_URL=
FORMS_HEALTH_URL=
BENCHMARK_RUNS=15
FORM_LOAD_CONCURRENCY=50
FORM_LOAD_STOCK=
LIVE_CAMPAIGN_USER_ID=
LIVE_CAMPAIGN_LIST_NAME=test
LIVE_CAMPAIGN_DESTINATION=
CAMPAIGN_ID=
DEMO_USER_EMAIL=
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_CLIENT_IP=
VITE_JWT_SECRET=
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=
